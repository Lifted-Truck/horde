  "$build_dir/bridge_utf8_check" src/gui > /tmp/bridgeutf8.$$ 2>&1 || {
    echo "verify[full]: bridge_utf8_check FAILED" >&2; cat /tmp/bridgeutf8.$$ >&2
    rm -f /tmp/bridgeutf8.$$; return 1; }
  tail -1 /tmp/bridgeutf8.$$; rm -f /tmp/bridgeutf8.$$
  # THE GUI'S WEB VIEW, RUN FOR REAL (B446 W3a; macOS, where the target is built).
  # The shipped plugin GUI on a WKWebView: it shows only its embedded page, only
  # that page's main frame reaches the bridge, run-time script injection does not
  # run under the embedded policy while every binding still resolves, page script
  # cannot paste, and hostile file names reach the dropdowns as text. Its CONTROL
  # rows must see each defect on a plain choc view, or it is red. ~10 s. Added
  # under ADR-180 §1.
  if [ "$(uname)" = Darwin ]; then
    "$build_dir/gui_webview_check" > /tmp/guiweb.$$ 2>&1 || {
      echo "verify[full]: gui_webview_check FAILED" >&2; cat /tmp/guiweb.$$ >&2
      rm -f /tmp/guiweb.$$; return 1; }
    tail -1 /tmp/guiweb.$$; rm -f /tmp/guiweb.$$
  fi
  # THE BUILT PLUGIN KEEPS ITS STORE IN ITS OWN IDENTITY'S FOLDER (B456; macOS).
  # Under a scratch HOME, with the OTHER identity's folder planted beside it (a
  # preset, a prefs file and a factory stamp naming the current bank), the shipped
  # plugin opens its GUI and saves, loads, lists and deletes through the page's own
  # bridge, and writes a forensic dump. Everything lands in LiftedTruck/HYPERSAW;
  # the planted folder keeps its files, bytes and modification times, its preset is
  # never listed, loaded or deleted, and its stamp does not stop the bank install
  # (a plugin that read that folder would install nothing). Its CONTROL judges the
  # same run as the other identity, which must fail. Here it proves the real build
