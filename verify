#!/usr/bin/env bash
# verify — oracle dispatcher. The harness's only interface to project QC.
# Usage: ./verify fast | full | report
# Contract: exit 0 = green, nonzero = red. Writes .harness/last-verify.json.
set -uo pipefail

TARGET="${1:-fast}"
HARNESS_DIR=".harness"
mkdir -p "$HARNESS_DIR"

# Kit-owned gates: record, leak_gate, kit_integrity. A repo missing this file
# is not a lesser repo, it is an UNGATED one, so failing loudly beats degrading
# quietly — a silently skipped privacy gate is exactly the shape of bug the
# gate exists to prevent.
if [ -r .kit/kit-gates.sh ]; then
  . .kit/kit-gates.sh
else
  echo "verify: .kit/kit-gates.sh missing — run kit_sync.py (gates cannot be skipped)" >&2
  exit 1
fi

# M_PI is a POSIX extension, NOT standard C++: MSVC does not define it without
# _USE_MATH_DEFINES, so it compiles everywhere the authors work and fails only on
# the Windows leg of CI. That is a 3-minute round trip to learn something a local
# grep answers instantly, and it has now bitten three times despite the lesson
# being written down in six files. Prose was not the missing piece; enforcement
# was. --untracked is load-bearing here for the same reason as in leak_gate: git
# grep skips new files otherwise, and a brand-new tool file is exactly the case.
portability_gate() {
  # B140 (human ruling 2026-09-17): the second MSVC class — a std symbol used
  # without its header in the same file. tools/include_check.py owns the table.
  python3 tools/include_check.py || return 1
  local hits
  hits=$(git grep --untracked -nI 'M_PI' -- '*.cpp' '*.h' '*.hpp' 2>/dev/null \
         | grep -vE '(//|/\*|\*).*M_PI' || true)
  [ -z "$hits" ] && return 0
  echo "verify: PORTABILITY — M_PI is undefined under MSVC; use a local kPi constant:" >&2
  echo "$hits" | sed 's/^/    /' >&2
  return 1
}

# PROJECT-OWNED GATE (not kit-owned; never move this into .kit/).
# Private-sibling real names in tracked files — ADR-014. This lived INSIDE the
# kit's leak_gate() until 2026-08-18, so the 2.4.0 vendoring migration removed it
# along with that function. It was never kit-owned: the alias rule is HYPERSAW
# substance, and the kit gate's business is identity PATHS, not our
# correspondents' names. Restored here, where it belongs — the misplacement is
# what the migration usefully exposed.
# The names live in .leakcheck-names, UNTRACKED, so this tracked gate never
# contains the thing it forbids. B446 W1b (2026-10-05): the inline version read
# the file from the WORKING TREE, which agent worktrees never have, so it passed
# silently in 45 of 49 of them. tools/private_name_check.py resolves the file
# through the git common dir (the main checkout), prints an absent file as a
# WARNING rather than a quiet SKIP (CI and clones still pass), and runs its own
# must-fail controls every time.
private_name_gate() {
  python3 tools/private_name_check.py
}

fast() {
  # ---- Layer-0: seconds, not minutes. CI-blocking. -------------------------
  # Honestly-scoped day-zero oracle: structure + manifest sanity. The real L0
  # suite (L0-1 parity vs JS reference, L0-2..13 trajectories — specs/ACCEPTANCE.md)
  # lands in Phase 1 and REPLACES nothing here; it adds. Never weaken without
  # a human decision recorded in ROADMAP.md.
  local ok=0
  kit_integrity || ok=1   # kit-owned files match .kit/MANIFEST
  leak_gate || ok=1          # privacy gate: kit-core, keep it first
  private_name_gate || ok=1  # privacy gate: OURS (ADR-014 alias rule)
  # IDENTITY STRINGS INSIDE BINARY FILES AND ARCHIVES (B446 W1b, wired in W2 with
  # the approved untracking of the bytecode file it was red on, ADR-194). The two
  # gates above read `git grep -I`, which skips binaries. Self-calibrating. Added
  # under ADR-180 §1.
  python3 tools/binary_hygiene_check.py || ok=1
  # SLUICE HOLD (B359, after the B358 incident): no private-sibling spec or
  # manifest text in any tracked file. The needles are read at runtime through
  # the gitignored local/sluice link and never written down; where the link is
  # absent (CI, other machines) it prints SKIPPED, like the gate above. Added
  # under ADR-180 §1; runs its own must-fail controls every time.
  # ADVISORY since 2026-10-04 (B418, the human: "demote sluice_hold to a warning").
  # It still runs and still ledgers what it fails, but a hit never fails verify: the
  # human owns both repos, and false positives (horde wording Sluice adopted, generic
  # phrases in other siblings' filings) cost more than the hold protects.
  python3 tools/sluice_hold_check.py || echo "verify[fast]: WARNING — sluice_hold flagged text (advisory, B418); see its lines above" >&2

  # OUTBOUND FILINGS ACTUALLY REACHED THE READER. Three forms of one failure in a
  # single day (uncommitted / side-branch / committed-but-never-pushed) stranded
  # an ack FOUNDATIONS was waiting seven hours for. Every form was silent from
  # both ends, so care cannot fix it — only a check can. Reads only; never writes
  # to a sibling, and no-ops where none is checked out (their R9 is the rule).
  python3 tools/mailbox_delivery_check.py || ok=1

  # PRESENTATION TABLE is total, address-keyed, and honest about its gaps. The
  # MVP generates ~75 gui2 controls from this table, so a missing row is a
  # control that silently never appears — the 29-dead-controls failure with the
  # arrow reversed, invisible to every audio oracle either way.
  python3 tools/presentation_check.py || ok=1
  # ADR-108: the dependency graph must stay well-formed and its generated
  # header current. Structure and staleness only — whether a declared
  # dependency is CORRECT is a human act (see the tool's own docstring).
  python3 tools/depends_check.py || ok=1
  # THIRD-PARTY LICENSES (B448 Wave C C1; armor risk row 12). Every component in
  # or beside the tree (submodules, fetched SDKs, what rides inside them, vendored
  # files) is in tools/license_inventory.json; its license text still reads as
  # the SPDX id on record; nothing ships under an id off the allow list; the
  # SBOM agrees; docs/LICENSES-THIRD-PARTY.md is current. An unapproved exception
  # listed in `pending_human` prints PENDING THE HUMAN and exits 0: a visible
  # hole, not a pass. Self-calibrating: its planted controls run every time.
  # Added under ADR-180 §1.
  python3 tools/license_audit_check.py || ok=1
  # horde 2's structural rules (ADR-186 item 4, ADR-187 item 3; B332 critic
  # review): h2 and src never include each other, no h2 target links the legacy
  # shell, every h2 build is contraction-off (ruled 2026-09-30: the shipped
  # build is the tested build), and the SCALPEL oracle's blob pin is current.
  # Self-calibrating.
  python3 tools/h2_rules_check.py || ok=1
  python3 tools/engine_enrolment_check.py || ok=1
  # HOST-VISIBLE PARAMETER IDS ARE APPEND-ONLY (B448 C2, ADR-197 risk row 7). A host
  # stores the id, not the name, in every saved session and automation lane, so a
  # renumbered, removed, reused or re-ranged id silently drives a different knob and no
  # audio oracle notices. tools/param_id_lock.json records every id the legacy shell
  # exposes (id, name, stepping, range, automatable); new ids may only be APPENDED
  # (`--append`), a human-approved break needs `--approve-change <id> <ref>`. In `fast`
  # the ids are extracted statically from the source (no build tree here); `full`
  # proves that extraction equals the real plugin's enumeration. Self-calibrating
  # (removed, renumbered, retyped, re-ranged, renamed, duplicate and reused ids, and
  # an --append that alters an entry, must all be refused). ~0.2 s. Added under
  # ADR-180 §1.
  python3 tools/param_id_lock_check.py || ok=1
  # THE BUILD FLAGS THAT DECIDE NUMERICS AND SAFETY ARE PINNED (B448 C2, ADR-197 risk
  # row 11). tools/build_flags_pin.json holds, per target class (legacy plugin, h2
  # parity, h2 product, the FMA controls, tools/oracles), the explicit compile and link
  # options and their conditions, plus the global settings (C++ standard, deployment
  # target, architectures), the sanitizer loops and each script's build type. Any
  # difference is red until `--approve <target> <ref>`, except that a NEW target whose flags
  # equal its class's is recorded by `--append` (never alters an entry); any fast-math-family flag in
  # CMakeLists.txt, verify, tools/ or the workflows is red outright (comments and
  # docstrings are blanked first). Static, no configure; `full` also reads the emitted
  # flags.make. Self-calibrating (planted -ffast-math and each sibling, a changed -O
  # level, a changed -ffp-contract, a removed target, a new global flag, an --append
  # that would alter an entry, an empty approval ref). ~0.3 s. Added under ADR-180 §1.
  python3 tools/build_flags_check.py || ok=1
  # THE REAL PLUGIN AND ITS SIDE-BY-SIDE TEST IDENTITY SHARE NO ID (B456). The same
  # sources build under a second identity (a CMake option, default OFF) so unmerged
  # code can run in a host BESIDE the plugin real projects load. A host finds a
  # plugin by its CLAP id (the VST3 class id derives from it) and its AU triple, and
  # the user's presets sit in one folder: a test build that kept any of those would
  # be loaded in place of the real plugin, or write its preset store, and no audio
  # oracle sees either. Static, from src/plugin_identity.h and CMakeLists.txt: the
  # real identity equals this check's frozen table (so changing it is red); CLAP id,
  # name, store folder, bundle identifier, output name and AU subtype all differ
  # between the two; the option defaults OFF and nothing the harness runs turns it
  # on; no source outside the identity header hard-codes an id or a store folder.
  # Self-calibrating (eighteen planted faults, each must read red with its own tag).
  # ~0.6 s. Added under ADR-180 §1. Its built-bundle and run-time halves are in `full`.
  python3 tools/test_identity_check.py || ok=1
  # A LIFTED h2 core is its legacy source plus its lift ledger, byte for byte
  # (B379; ADR-187 L3: a byte-identical lift carries the legacy parity proof).
  # Any unledgered difference, or a ledger entry the tree no longer carries, is
  # red. Self-calibrating. Added under ADR-180 §1.
  python3 tools/h2_lift_check.py || ok=1
  # EVERY GOLDEN PINNED IN h2/README.md still IS its pinned blob (B419, L0073).
  # ci.yml skips docs/** (paths-ignore), so a docs-only PR never runs the sanitize
  # lanes that hold the parity check's PIN row; docs.yml runs only `verify fast`.
  # B407 moved a pinned golden under docs/** and merged unseen. This is that row's
  # cheap half, in `fast`. Self-calibrating (blob, missing, zero-pin controls). Added under
  # ADR-180 §1.
  python3 tools/golden_pin_check.py || ok=1
  # THE USER MANUAL'S PLACEHOLDERS AND ITS FIGURE REGISTRY AGREE (B451). Every
  # [[FIG|TAB|AUD:id]] in docs/manual/NN-*.md has one docs/manual/figures.json entry and
  # every entry one placeholder; ids are unique; fields, kinds and statuses are
  # known; every depends_on id is a real H2-PLAN part, ROADMAP row or ADR; every
  # section carries a PENDING / READY-TO-WRITE status. Two lists describing one set
  # drift silently, and no audio oracle sees it. Self-calibrating (seven planted
  # faults must read red, the untouched copy green). ~0.1 s. Added under ADR-180 §1.
  python3 tools/manual_scaffold_check.py || ok=1
  # EVERY COMPARISON TOLERANCE IS PINNED (B448 A3, ADR-197 armor edit G, "tolerance
  # creep"). Tolerances widen a little per PR until the test means nothing, and the
  # widened test still passes, so no oracle sees it. docs/armor/tolerances.json pins
  # the value of every one found in specs/ACCEPTANCE.md, tools/**/*.py, the C++ checks
  # and this file; any change, deleted target or unregistered newcomer is red until the
  # human's approval is recorded as `approved: <ref>`. Self-calibrating (five planted
  # faults plus an empty-ref approval, all must go red/refused). ~1 s. Added under
  # ADR-180 §1.
  python3 tools/tolerance_registry_check.py || ok=1

  # GENERATED CONTROLS ARE CURRENT. gui2's controls are generated FROM the
  # presentation table, so an edited table with stale markup shows yesterday's
  # declarations — invisible to every audio oracle, which is why it is gated.
  python3 tools/gen_gui_controls.py --check || ok=1

  # THE TEST TABLE cannot claim coverage it lacks: every agentic row names a gate
  # this file actually runs (parsed from here, never a second list), and every
  # feature the GUI shows has at least one row. Both failure modes — an oracle
  # nobody wrote, a feature nobody tests — are silent by construction.
  python3 tools/test_table_check.py || ok=1
  portability_gate || ok=1   # MSVC-only breakage, caught locally not in CI

  # BANNED C LIBRARY CALLS (B446 W1b): no strcpy/strcat/sprintf/vsprintf/gets/
  # system/popen in src/ or h2/, code only (comments and strings are blanked
  # first). The tree was clean when this landed, so this is a ratchet, not a
  # cleanup. Self-calibrating (planted-line control in a scratch repo). Added under
  # ADR-180 §1.
  python3 tools/banned_api_check.py || ok=1
  # GATE-WEAKENING COUNTER (B448 A2, ADR-197 "Quiet disabling" and "Symptom
  # clamping"). Skips, suppressions, disabled sanitizers, soft-failed steps,
  # UNWIRED declarations and new isfinite/isnan/clamp guards in src/ and h2/ are
  # counted per (category, file) against docs/armor/weakening-baseline.json; ANY
  # increase is red until the human's approval is recorded as a ref in that
  # entry. A ratchet, not a cleanup: the baseline is today's tree. Self-calibrating
  # (a planted marker per category in a scratch repo must read red). Added under
  # ADR-180 §1.
  python3 tools/weakening_check.py || ok=1
  python3 tools/deny_hook_check.py || ok=1   # B446 D-S6: the deny hook's verdict table
  # THE CLOSING GATE'S VERDICT TABLE (B455 H2, ADR-206 item 3). The Stop hook is what
  # makes "a session cannot finish on unverified edits" true, and nothing exercised
  # it. It runs the real hook file in scratch repositories against 16 situations:
  # an edit made through the shell, a new file, and a commit made with no verify
  # record must each block; verify-then-commit must not. Two faulty hooks are the
  # controls: one that never blocks, and the hook as it stood before this change,
  # which must fail exactly the tree-state rows. ~2 s. Added under ADR-180 §1.
  python3 tools/stop_gate_check.py || ok=1
  # GUI PAGE SINKS AND POLICY (B446 W3a). In src/gui/*.html every innerHTML /
  # outerHTML / insertAdjacentHTML / document.write gets literals only (named
  # exceptions carry a reason), and the content policy the build embeds is
  # hash-only for scripts with default-src 'none'. Self-calibrating. Added under
  # ADR-180 §1. Its run-time half is gui_webview_check in `full`.
  python3 tools/gui_sink_check.py || ok=1
  # THE CHOC PATCHES ARE CARRIED, COMPILED AND USED (B446, ADR-194 D-S5, ADR-196;
  # the third patch: B448 C3, ADR-205 item 3). The Windows GUI admits only its
  # embedded page, refuses page script every permission (clipboard reads
  # included), and turns off drops from outside the view, through three options
  # libs/patches adds
  # to choc. Red if the build's list and the patch files disagree, if a patch's
  # base is not the libs/choc pin, if one removes an upstream line, if the build's
  # own apply step fails on the list, in any other order or on any patch alone, if
  # anything includes the unpatched header, or if the Windows backend stops
  # passing its policies, its own origin (not choc's shared one) or binding
  # native PASTE. For the third patch it is also red if the new option does not
  # default to true (choc's behaviour for other users), if the two WebView2
  # interfaces it declares differ from the recorded SDK ids or method order (a
  # wrong order calls the wrong vtable slot), or if the call is not gated on the
  # option and on the interface query. Thirty-eight must-fail controls. Without a choc
  # checkout (CI's fast job) the apply rows print a WARNING; every build job
  # applies the patches with a hard stop. Added under ADR-180 §1.
  python3 tools/choc_patch_check.py || ok=1
  # THE PAGE-ONLY RULE, BY BEHAVIOUR (B446 D-S5, critic round). The Windows GUI's
  # navigation policy is a pure function (src/gui/embedded_page_policy.h); this
  # compiles its check with the host compiler (no build tree, no choc) and drives
  # it through fixed request sequences, beside four faulty policies (accept any
  # source, dropped latch, prefix matching, exact-match messages) that must each
  # read red. Also the permission rule (ADR-196): every kind refused, beside
  # upstream choc's clipboard grant and a known-kinds deny-list, both must read
  # red. ~1 s. Added under ADR-180 §1.
  python3 tools/embedded_page_policy_check.py || ok=1
  # THE OUTPUT GUARD LATCHES AND REPORTS (B448 B1, ADR-197 risk row 3). The last
  # line before the host's bus still zeroes a non-finite sample, but now counts it
  # and sets a latch only reset() clears (src/output_latch.h, shared with the
  # plugin). Compiled with the host compiler (no build tree): planted NaN / +Inf /
  # -Inf, in each channel, are zeroed AND counted AND latch; a clean buffer counts
  # 0 and stays bit-identical; beside five faulty guards (zero-without-count,
  # count-without-latch, self-clearing latch, right channel unreported, reset keeps
  # the latch) that must each read red; plus a text check that process() reaches
  # the latch, with a planted bare zeroNonFinite as its control. ~2 s. Added under
  # ADR-180 §1.
  python3 tools/nan_latch_check.py || ok=1
  # ONE SIZE CAP ON STATE TEXT FROM THE PAGE AND THE CLIPBOARD (B446, critic
  # MEDIUM-3 on PR #973). kMaxPastedStateBytes is re-derived from the factory
  # bank; hzApplyState and both backends' hzPasteState test it before copying;
  # pasteStatus refuses over-cap text with zero allocations, beside two faulty
  # versions (copy-then-check, no cap) that must read red. ~1 s. Added under
  # ADR-180 §1.
  python3 tools/paste_cap_check.py || ok=1
  # THE ARMOR CATALOGUE (B448 A1, ADR-197). docs/armor/catalogue.json holds one row
  # per risk-register row, agent-signature rule and security category; each row is
  # a gate this file or a workflow actually runs (parsed, never listed), or a hole
  # with an owner and an expiry. Red on a gateless non-hole, an unowned or expired
  # hole, a named gate nothing runs, a guarded row with gaps, the wrong id set, or
  # a private name. Ten must-fail controls on planted catalogues every run. Prints
  # the one-line armor score. Added under ADR-180 §1.
  python3 tools/armor_coverage_check.py || ok=1
  # The human's dashboard (docs/armor/dashboard.html) is generated from that
  # catalogue plus, once they exist, docs/armor/{tolerances,weakening-baseline}.json
  # (no timestamp, no git); red when the committed page differs from the generator's.
  # Added under ADR-180 §1.
  python3 tools/armor_dashboard.py --check || ok=1

  # DEV TOOLING (B446 W3b, ADR-194 W2-05/-06). The labs server serves only the lab
  # trees, refuses a foreign Host header and any symlink out of them; labs_preview.sh
  # runs nothing a lab branch supplied. Each check holds its own must-fail controls
  # (the stock handler leaks; a planted marker script is shown to fire when run by
  # hand). ~2 s each, no network. Added under ADR-180 §1.
  python3 tools/serve_labs_check.py > /tmp/servelabs.$$ 2>&1 || {
    echo "verify: labs server check FAILED" >&2; cat /tmp/servelabs.$$ >&2; ok=1; }
  tail -1 /tmp/servelabs.$$; rm -f /tmp/servelabs.$$
  python3 tools/labs_preview_check.py || ok=1

  # CI AND RELEASE PATH (B446 Wave 2, ADR-194). Workflows pin every action by
  # commit, declare a read-only top-level token, and keep event text out of
  # scripts; releases attach an explicit file list with checksums and an SBOM,
  # and nothing is packaged under a tracked path. The second also runs the
  # tag-only SBOM generator so it cannot rot until a release. Both
  # self-calibrating. Added under ADR-180 §1.
  python3 tools/workflow_pin_check.py || ok=1
  python3 tools/release_path_check.py || ok=1

  # GUI REACHABILITY (L0023, third occurrence — the one that became a gate).
  # A param with no control anywhere ships fully implemented, fully tested,
  # host-automatable and ABSENT FROM THE PRODUCT, and no audio oracle can see it
  # because the audio path is correct. It has cost: FX types 0..5 with dropdowns
  # offering 0..3 for two weeks; a panic button missing from the shipping GUI;
  # and gui2 reaching 18 of 105 params while being someone's daily driver.
  # Gates the unambiguous case (unreachable EVERYWHERE); prints per-GUI coverage
  # so the renovation gap stays visible instead of forgotten again.
  python3 tools/gui_reach.py || ok=1

  # Structure: the canonical docs and the reference implementations exist.
  local f
  for f in specs/SPEC.md specs/ACCEPTANCE.md ROADMAP.md DECISIONS.md README.md CLAUDE.md \
           INDEX.md LIBRARY.md project.manifest.json \
           reference/swarmsaw.html reference/swarmspectra.html reference/swarmdynamics.html \
           reference/swarmfilter.html reference/swarmphaser.html reference/swarmtime.html specs/SPEC-EFFECTS.md \
           reference/swarmalator.html specs/SPEC-SWARMALATOR.md; do
    [ -f "$f" ] || { echo "verify: MISSING $f" >&2; ok=1; }
  done

  # Manifest parses and pins the essentials.
  python3 - << 'PY' || ok=1
import json, sys
m = json.load(open("project.manifest.json"))
s = m["survey"]
# RE-PINNED 2 -> 3 on the human's explicit ratification, 2026-08-15. This stays a
# HARDCODED pin rather than a softer "cites a ratification date" check: the whole
# point is that ANY drift fails, and a check that accepts a rung plus a plausible
# date would pass the drift it exists to catch. Raising this number is a human
# decision every time, and it caught the lead attempting exactly that.
assert s["architecture_rung"]["choice"] == 3, "rung drifted from ratified answer"
assert s["knowledge_loop_tags"], "knowledge-loop tags missing"
assert m["model_routing"]["lead"] == "opus", "model pin drifted"
PY

  # Knowledge loop integrity: every INDEX pointer resolves in LIBRARY.
  python3 - << 'PY' || ok=1
import re
idx = set(re.findall(r'\[(L\d{4})\]', open("INDEX.md").read()))
lib = set(re.findall(r'\[(L\d{4})\]', open("LIBRARY.md").read()))
missing = idx - lib
assert not missing, f"INDEX ids missing from LIBRARY: {missing}"
PY

  # Labs must SURVIVE LOADING (L0026, human-approved gate 2026-08-06). Five
  # times a lab shipped with a setup-time call reaching a `const` declared
  # further down; the browser swallows the throw, the rest of the script never
  # runs, and the page still looks fine — the mod lab's whole matrix was gone
  # for weeks that way. Executes each <script> under stub DOM globals, so what
  # surfaces is real JS (TDZ, typos), not missing-canvas noise. Calibrated
  # against both historical bugs re-injected; see the trace.
  if command -v node >/dev/null; then
    node tools/labharness/lab_load_check.mjs > /tmp/labload.$$ 2>&1 || {
      echo "verify: lab load check FAILED" >&2; cat /tmp/labload.$$ >&2; ok=1; }
    rm -f /tmp/labload.$$

    # THE LAB HARNESSES RUN UNDER NODE'S PERMISSION MODEL (B446 W3b, L3-M6/L4-M6).
    # lab_load_check and five sibling checks run lab and packet JS in node:vm, which
    # is not a sandbox: a lab script reaches the host process from inside it.
    # tools/labharness/sandboxed_node.mjs gives them read-only access to the lab
    # trees and nothing else. This plants labs that make that climb and try to write,
    # spawn, read outside the grant, call process.binding and start a worker; each
    # must be refused, after the same payload is shown to fire outside the sandbox.
    # It also pins that an untracked HTML in a lab tree is not executed. ~2 s.
    node tools/labharness/sandbox_check.mjs > /tmp/sandboxchk.$$ 2>&1 || {
      echo "verify: lab sandbox check FAILED" >&2; cat /tmp/sandboxchk.$$ >&2; ok=1; }
    tail -1 /tmp/sandboxchk.$$
    rm -f /tmp/sandboxchk.$$

    # THE FX LAB'S EQ AND COMP PICTURES ARE THE DSP'S (B234). The lab draws an
    # EQ curve and a compressor transfer curve and measures both at load with
    # sines, each against a must-fail control (a 48 kHz curve, a hard-knee
    # curve, B230's shared envelope). The page only prints the verdict; this
    # runs the same self-checks headlessly (~1 s) so a lying picture fails CI.
    node tools/labharness/fxlab_check.mjs > /tmp/fxlab.$$ 2>&1 || {
      echo "verify: FX lab self-check FAILED" >&2; cat /tmp/fxlab.$$ >&2; ok=1; }
    tail -1 /tmp/fxlab.$$
    rm -f /tmp/fxlab.$$

    # THE FILTER LAB'S FIDELITY PROGRAMME IS A GATE (B274). docs/design/filter-lab.html
    # measures twelve filter types with seven checks each (analytic response,
    # cutoff/res accuracy, self-oscillation, fast modulation, aliasing, level at
    # resonance, DC), every check with a must-fail control. This runs the lab's own
    # DSP section headless (~1.5 s): red on a blind control, on a verdict that
    # differs from its pin (a FAIL is a pinned FINDING, never a loosened
    # tolerance), or on a planted fault it fails to catch. Added under ADR-180 §1.
    node tools/labharness/filter_fidelity_check.mjs > /tmp/filtfid.$$ 2>&1 || {
      echo "verify: filter lab fidelity check FAILED" >&2; cat /tmp/filtfid.$$ >&2; ok=1; }
    tail -1 /tmp/filtfid.$$   # the harness prints its own name; do not prefix it twice
    rm -f /tmp/filtfid.$$

