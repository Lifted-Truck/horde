  if [ "$(uname)" = Darwin ]; then
    "$build_dir/identity_store_check" real > /tmp/identstore.$$ 2>&1 || {
      echo "verify[full]: identity_store_check FAILED" >&2; cat /tmp/identstore.$$ >&2
      rm -f /tmp/identstore.$$; return 1; }
    tail -1 /tmp/identstore.$$; rm -f /tmp/identstore.$$
  fi
  "$build_dir/hostile_events_check" > /tmp/hostile.$$ 2>&1 || {
    echo "verify[full]: hostile_events_check FAILED" >&2; cat /tmp/hostile.$$ >&2
    rm -f /tmp/hostile.$$; return 1; }
  tail -1 /tmp/hostile.$$; rm -f /tmp/hostile.$$

  # FORENSIC NOTE TRACE (FOUNDATIONS ask (c), 2026-08-11). The stuck-note bug
  # survived weeks because it could not be REPRODUCED — and a generator never
