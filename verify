  # ADR-186 copy-forward, ADR-187 item 6 parity strength). The check spawns
  # `node tools/h2_scalpel_render.mjs` (here: once, to a file it reads), which renders 386 scenarios (all 83 bench
  # presets x phrases, plus targeted rows) through the protected oracle above, and
  # demands rms < 1e-6, max-abs < 1e-6 and identical blade events for each. A
  # chaotic exclusion is exempt from max-abs only, is re-justified every run
  # (ADR-065's rule) and its count is pinned; planted port faults (samples-only,
  # events-only, both) must each turn a row red, and the detection floor is
  # printed. Wired in the PR that adds it (ADR-180 §1). ~30 s here, almost all
  # Node. Captured (a row per scenario); the exclusion evidence, the floor and the
  # verdict are echoed on green runs too, so a reader sees what was exempted.
  # The FMA control is the same source built with contraction forced on, run over
  # the full stream: exit 0 = the parity gate CAUGHT the fused build, 1 = it did
  # not fire, 2 = the run itself broke (never counted as firing).
  # THE SCENARIO FLOOR (ADR-206 item 1, B455 H1 follow-up): the stream is rendered ONCE to a
  # file (the gate and its FMA control used to render it twice), and all three read it with
  # --full-from. The gate pins the total (kMinScenarios, its own source): a stream with a scenario
  # dropped and its header and END rewritten to agree used to pass. This run of the gate on the
  # untouched file is the POSITIVE control; tools/parity_floor_check.py --stream then runs the
  # must-fail controls (DROP, HEADER-ONLY, EMPTY, ABSENT) against files derived from it.
  local h2sc="/tmp/h2scalpelstream.$$" h2sr="/tmp/h2scalpelrender.$$"
  node tools/h2_scalpel_render.mjs > "$h2sc" 2> "$h2sr" || {
    echo "verify[full]: tools/h2_scalpel_render.mjs FAILED (the oracle's stream)" >&2; cat "$h2sr" >&2
    rm -f "$h2sc" "$h2sr"; return 1; }
  tail -1 "$h2sr"; rm -f "$h2sr"
  "$build_dir/h2_scalpel_parity_check" --full-from "$h2sc" > /tmp/h2scalpel.$$ 2>&1 || {
    echo "verify[full]: h2_scalpel_parity_check FAILED" >&2; grep -v '^PASS  rms' /tmp/h2scalpel.$$ >&2
    rm -f /tmp/h2scalpel.$$ "$h2sc"; return 1; }
  grep -E '^(EXCL|PASS  (PIN|FLOOR)|OK   h2_scalpel_parity|NOTE h2_scalpel_parity)|chaotic\?' /tmp/h2scalpel.$$
  tail -1 /tmp/h2scalpel.$$; rm -f /tmp/h2scalpel.$$
  local h2fma=0
  "$build_dir/h2_scalpel_fma_control" --full-from "$h2sc" > /tmp/h2fma.$$ 2>&1 || h2fma=$?
  if [ "$h2fma" -ne 0 ]; then
    if [ "$h2fma" -eq 1 ]; then
      echo "verify[full]: h2_scalpel_fma_control did not fire (the FMA-contracted build passed parity)" >&2
    else
      echo "verify[full]: h2_scalpel_fma_control run broke (exit $h2fma) — infrastructure, not a verdict" >&2
    fi
    grep -v '^PASS  rms' /tmp/h2fma.$$ >&2; rm -f /tmp/h2fma.$$ "$h2sc"; return 1
  fi
  tail -1 /tmp/h2fma.$$; rm -f /tmp/h2fma.$$
  python3 tools/parity_floor_check.py --stream "$build_dir" h2_scalpel_parity_check "$h2sc" || {
    echo "verify[full]: h2_scalpel_parity_check scenario-floor controls FAILED" >&2; rm -f "$h2sc"; return 1; }
  rm -f "$h2sc"
  # horde 2's ONE engine, the composed engine h2/engine/ (B385; wired by B405 under
  # ADR-187 A2 and ADR-180 §1). `node tools/h2_engine_render.mjs` renders the
  # scenarios through the composed JS golden ONCE, to a temp file both binaries read
  # with --full-from (B405 rework, critic M4: it used to render twice). The check
  # pins their COUNT in its own source (kMinScenarios, 543 today; ADR-206 item 1,
  # B455 H1 follow-up): the header/END/row agreement it always checked is a
  # consistency check, not a floor, so a stream with a scenario dropped and its
  # header and END rewritten to agree passed until then. tools/parity_floor_check.py
  # --stream runs that shape as a must-fail control (DROP) beside HEADER-ONLY, EMPTY
  # and ABSENT, after the real run below, which is the POSITIVE. The check
  # demands rms < 1e-6, max-abs < 1e-6, identical blade events and identical load
  # readouts for each. The three Cross-mod ring (watch) rows, pinned by name, are
  # judged on a measured onset window, events, readouts and a finite render instead
  # (A2 item 1). Planted engine faults must each turn their row red (X1-late must
  # turn a NON-chaotic xm row red), the five golden blobs must match h2/README.md's
  # pins, the bit-exact floor gates on its keyed platform only (A2 item 2), and
  # determinism is checked across host block sizes and a child process. TRUNC, the
  # file path's own must-fire: the stream cut at 8 MB (no END record) must turn the
  # check red on its STREAM row and make the FMA control report BROKEN (exit 2),
  # never fired. Captured (a row per scenario); echoed on green runs too: the
  # exclusions with their onset profiles, every control with X1-late's red rows,
  # its margin sweep and the ring's blind spot, the floor, and its upgrade WARNING
  # (also sent to stderr; it does not change the exit, which is the human's call).
  # The FMA control: exit 0 = caught, 1 = not, 2 = the run broke. Every temp file is
  # removed on every path.
  local h2s="/tmp/h2stream.$$" h2e="/tmp/h2engine.$$" h2f="/tmp/h2efma.$$" h2r="/tmp/h2render.$$" h2c="/tmp/h2cut.$$"
  local h2tmp="$h2s $h2e $h2f $h2r $h2c" h2x=0
  node tools/h2_engine_render.mjs > "$h2s" 2> "$h2r" || {
    echo "verify[full]: tools/h2_engine_render.mjs FAILED (the composed golden's stream)" >&2; cat "$h2r" >&2
    rm -f $h2tmp; return 1; }
  tail -1 "$h2r"
  head -c 8000000 "$h2s" > "$h2c"
  "$build_dir/h2_engine_parity_check" --full-from "$h2c" > "$h2e" 2>&1 || h2x=$?
  if [ "$h2x" -ne 1 ] || ! grep -q '^FAIL  STREAM' "$h2e"; then
    echo "verify[full]: TRUNC did not fire: a stream file cut short (no END) was not red on STREAM (exit $h2x)" >&2
    grep -v '^PASS  rms' "$h2e" >&2; rm -f $h2tmp; return 1
  fi
  h2x=0
  "$build_dir/h2_engine_fma_control" --full-from "$h2c" > "$h2f" 2>&1 || h2x=$?
  if [ "$h2x" -ne 2 ]; then
    echo "verify[full]: TRUNC did not fire: the FMA control on a cut stream exited $h2x, want 2 (broken, never fired)" >&2
    tail -3 "$h2f" >&2; rm -f $h2tmp; return 1
  fi
  echo "PASS  TRUNC  the stream cut at 8 MB (no END): h2_engine_parity_check red on STREAM (exit 1), h2_engine_fma_control broken (exit 2)"
  rm -f "$h2c"
  "$build_dir/h2_engine_parity_check" --full-from "$h2s" > "$h2e" 2>&1 || {
    echo "verify[full]: h2_engine_parity_check FAILED" >&2; grep -v '^PASS  rms' "$h2e" >&2
    rm -f $h2tmp; return 1; }
  grep '^WARNING: bit-exact floor' "$h2e" >&2
  grep -E '^(EXCL|SKIP|WARNING|OK   h2_engine_parity|NOTE h2_engine_parity|PASS  (STREAM|PIN|FLOOR|BITEXACT|control X1|control BF))|^        (onset profile|red: |margin sweep|\(ring, not judged\))' "$h2e"
  tail -1 "$h2e"
  python3 tools/parity_floor_check.py --stream "$build_dir" h2_engine_parity_check "$h2s" || {
    echo "verify[full]: h2_engine_parity_check scenario-floor controls FAILED" >&2; rm -f $h2tmp; return 1; }
  h2x=0
  "$build_dir/h2_engine_fma_control" --full-from "$h2s" > "$h2f" 2>&1 || h2x=$?
  if [ "$h2x" -ne 0 ]; then
    if [ "$h2x" -eq 1 ]; then
      echo "verify[full]: h2_engine_fma_control did not fire (the FMA-contracted build passed the gate)" >&2
    else
      echo "verify[full]: h2_engine_fma_control run broke (exit $h2x) — infrastructure, not a verdict" >&2
    fi
    grep -v '^PASS  rms' "$h2f" >&2; rm -f $h2tmp; return 1
  fi
  tail -1 "$h2f"
  # The composed engine against ITSELF (B441 phase 2; ADR-187 item 5's "output-
  # neutral work must leave every digest unchanged"): on the same stream, every
  # scenario's C++ samples, events and readouts digested (FNV-1a 64) and compared
  # with the committed h2/engine/selfdigest.<build>.<key>.txt; on an unkeyed
  # platform printed and SKIPPED, never passed. Two builds of one source, each
  # against its own reference: the parity build (-O2, fault hooks; controls: a
  # 1-ULP nudge to one row, red by name, and fault K1 planted, >= 100 rows red)
  # and the product build (-O3, no hooks; ADR-187 A1; the ULP control, and how many
  # rows share the parity digest, printed as context, never judged). The controls,
  # the context line and the verdicts are echoed; a digest row per scenario is
  # captured. Added under ADR-180 §1. ~23 s + ~12 s here (the stream is reused).
  # Two literal invocations, not a loop over names: test_table_check detects
  # wiring by the quoted "$build_dir/<name>" form, and a loop variable hides it.
  "$build_dir/h2_engine_selfdigest_check" --full-from "$h2s" > "$h2e" 2>&1 || {
    echo "verify[full]: h2_engine_selfdigest_check FAILED" >&2; grep -vE '^[0-9a-f]{16}  ' "$h2e" >&2
    rm -f $h2tmp; return 1; }
  grep '^WARNING: self-digest' "$h2e" >&2
  # COVERAGE (B441 C3/C3b: every specialised kernel and serial order reached) was
  # always judged by the exit code; it is echoed too (output only, ADR-180 §1).
  grep -E '^(TOTAL|SKIP|PASS  (control|KEYSELF|SELFDIGEST|COVERAGE))' "$h2e"
  tail -1 "$h2e"
  "$build_dir/h2_engine_selfdigest_product" --full-from "$h2s" > "$h2e" 2>&1 || {
    echo "verify[full]: h2_engine_selfdigest_product FAILED" >&2; grep -vE '^[0-9a-f]{16}  ' "$h2e" >&2
    rm -f $h2tmp; return 1; }
  grep '^WARNING: self-digest' "$h2e" >&2
  grep -E '^(TOTAL|SKIP|CONTEXT|PASS  (control|KEYSELF|SELFDIGEST))' "$h2e"
  tail -1 "$h2e"; rm -f $h2tmp
  # horde 2's lifted swarm core (B379 step 1, h2/cores/swarm/): lift edit E1
  # re-proven. A Voice the caller owns, started with initVoice() and ticked
  # through the one public forwarder E1 adds, must match the core's own voice
  # bit for bit (coupling, drift, inertia and onset lock on; 44.1 and 48 kHz),
  # and a one-sample schedule slip must be caught. Added under ADR-180 §1.
  "$build_dir/h2_swarm_lift_check" || { echo "verify[full]: h2_swarm_lift_check FAILED" >&2; return 1; }

  # THE B159 BACKLOG, ruled one at a time on evidence (2026-09-21). Nine checks
  # sat unwired: five stated no reason at all, four cited a "standing human
  # ruling on gate scope" that the ADR-179 §4 inversion overturned on
  # 2026-09-19 — an inherited exemption, not a decision. Each was run before
  # being wired; eight were green, and combguard_check was RED on arrival for a
  # reason inside the ORACLE (see its header's age-matching note), which is the
  # whole argument for the inversion: a check nobody runs is a check nobody
  # knows the state of. Measured cost of the nine together: 2.0 s, against a
  # 75.5 s warm `verify full` baseline. None duplicates a wired check —
  # fxxfade_plugin_check is the PLUGIN-PATH half of fxxfade_check's core-level
  # claim (L0031: an oracle that builds the core directly gives the shell path
  # zero coverage), and the other eight guard cores nothing else touches.
  "$build_dir/delay_check"                              || return 1   # ADR-142 standard delay, spec-as-contract
  "$build_dir/mixer_check"                              || return 1   # B24 per-oscillator mute/solo gate the mix
  "$build_dir/mod_check"                                || return 1   # mod_core matrix: sum law, scope, refusals
  "$build_dir/strata_check"                             || return 1   # STRATA §2.2's six properties
  "$build_dir/voicetap_check"                           || return 1   # ADR-148 per-voice seam is bit-identical
  "$build_dir/combguard_check"                          || return 1   # a second Comb is impossible, not just loud
  "$build_dir/fxxfade_plugin_check"                     || return 1   # B117 through the plugin's param path
  "$build_dir/svf_check"                                || return 1   # SvfCore's oracle-as-spec (no reference lab)
  # paramclass_check is CAPTURED, not printed: it reports 289 lines (a row per
  # id) and a gate that buries the run in its own output stops being read. The
  # final line is echoed — a green gate that prints nothing reads as no gate.
  # It pins the classification the morph field depends on, and that pin moved
  # twice in the week it was only ever run by hand.
  "$build_dir/paramclass_check" > /tmp/paramclass.$$ 2>&1 || {
    echo "verify[full]: paramclass_check FAILED" >&2; cat /tmp/paramclass.$$ >&2
    rm -f /tmp/paramclass.$$; return 1; }
  echo "paramclass_check: $(tail -1 /tmp/paramclass.$$)"
  rm -f /tmp/paramclass.$$
  # The SAW fidelity suite (B147 layer 2, PR #635), wired by the human's ruling
  # 2026-09-18 (ADR-171 A1). Thresholds are the audit's MEASURED numbers plus a
  # stated margin; every check carries a must-fail control. cpu_check is NOT here —
  # a timing measurement must not gate CI; run it by hand, numbers to ACCEPTANCE.
  # stability_check runs 60 simulated seconds here; the 600 s run is by hand.
  "$build_dir/alias_check"                              || return 1   # aliasing floor across the keyboard
  "$build_dir/sr_check"                                 || return 1   # sample-rate independence in seconds
  "$build_dir/blocksize_check"                          || return 1   # block-size independence (pan motion reported, B151)
  "$build_dir/stability_check" --seconds=60             || return 1   # long-run stability, 60 s sim
  "$build_dir/denormal_check"                           || return 1   # denormal silence in the tail
  # The two defects the same audit found that SHIPPED and were fixed on
  # 2026-09-18 — an unwired oracle for a bug that already reached a user is the
  # weakest position in the set. Wired by the human's ruling 2026-09-19
  # (ADR-179 §4). Both sit here because both are SAW-fidelity rows driving
  # SwarmCore at the audit's level, like alias_check above; both are sub-second.
  "$build_dir/ncap_check"                               || return 1   # B148 n can never index past kMaxV
  "$build_dir/tseed_check"                              || return 1   # B149 ensemble-timing stream seeded + in the chunk
  # B335: the same ensemble timing rendered by swarm_core.h itself is the reference the
  # composed engine's JS transcription is compared with (composed_engine_check ONS/VENV,
  # above, reads the committed file); this re-derives it from the C++ of the day and fails
  # when the committed copy is stale. Added under ADR-180 §1; sub-second.
  "$build_dir/onset_ref_check" tools/labharness/onset_ref_cpp.json || return 1
  # Note-lifecycle guard (ADR-038): seeded note on/off streams must decay to
  # silence — the oracle for the 2026-07-18 "doesn't stop when you let go" hang.
  # Statically linked like state_check; no goldens. (Was built but ungated.)
  "$build_dir/notefuzz_check" || return 1

  # BOUNDARY GUARDS (B446 P1; src/input_guards.h). Added under ADR-180 §1.
  # bridge_utf8_check: every name is cut at a character boundary and every string
  # the GUI bridge returns is valid UTF-8 (one helper, bridgeStr, statically held);
  # its CONTROL row must show the raw escaper mishandling malformed input, or it is
  # red. hostile_events_check: out-of-range note keys and non-finite or
  # out-of-range expression values are handled at the event boundary and the
  # output stays finite; its CONTROL rows must show the unguarded core going
